/*!
 * \file fused_bias_silu.asc
 * \brief A5 SIMT/SIMD 混合样例：融合 Bias + SiLU + Residual 算子。
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 3
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 3
#error "SCENARIO_NUM must be one of 0, 1, 2, 3."
#endif

namespace {
constexpr uint32_t DEVICE_ID = 1;
constexpr uint32_t HIDDEN_SIZE = 4096;
constexpr uint32_t THREADS_PER_BLOCK = 2048;
constexpr uint32_t TILE_BYTES = HIDDEN_SIZE * sizeof(float);
constexpr uint8_t SINGLE_BUFFER_MUTEX = 0;
constexpr uint8_t DB_INPUT_MUTEX_BASE = 0;
constexpr uint8_t DB_OUTPUT_MUTEX_BASE = 2;
// Case 3 将任务按半行切分为段，使 256 行均匀分布到 56 个 block 上。
constexpr uint32_t SEG_FLOATS = 2048;
constexpr uint32_t SEG_BYTES = SEG_FLOATS * sizeof(float);
constexpr uint32_t SEGS_PER_ROW = HIDDEN_SIZE / SEG_FLOATS;

struct LaunchConfig {
    uint32_t rows;
    uint32_t core_num;
    aclrtStream stream;
};

const char* get_case_name()
{
    switch (SCENARIO_NUM) {
        case 0:
            return "simd_mte_simt_ub";
        case 1:
            return "fixed_mapping_unroll";
        case 2:
            return "row_double_buffer";
        case 3:
            return "segment_double_buffer";
        default:
            return "unknown";
    }
}

std::vector<float> compute_golden(
    const std::vector<float>& input, const std::vector<float>& bias, const std::vector<float>& residual,
    uint32_t rows)
{
    std::vector<float> output(input.size());
    for (uint32_t row = 0; row < rows; ++row) {
        for (uint32_t col = 0; col < HIDDEN_SIZE; ++col) {
            const size_t index = static_cast<size_t>(row) * HIDDEN_SIZE + col;
            const float value = input[index] + bias[col];
            output[index] = residual[index] + value / (1.0f + std::exp(-value));
        }
    }
    return output;
}

bool verify_result(const std::vector<float>& output, const std::vector<float>& golden)
{
    constexpr float ABS_TOLERANCE = 2e-5f;
    constexpr float REL_TOLERANCE = 2e-5f;
    float max_error = 0.0f;
    size_t max_error_index = 0;
    for (size_t i = 0; i < output.size(); ++i) {
        const float error = std::fabs(output[i] - golden[i]);
        const float tolerance = ABS_TOLERANCE + REL_TOLERANCE * std::fabs(golden[i]);
        if (error > max_error) {
            max_error = error;
            max_error_index = i;
        }
        if (error > tolerance) {
            std::fprintf(
                stderr, "[Failed] Accuracy mismatch at %zu: output=%f, golden=%f, error=%e, tolerance=%e\n",
                i, output[i], golden[i], error, tolerance);
            return false;
        }
    }
    std::printf("[Success] Accuracy verification passed. max_abs_error=%e at index=%zu\n", max_error, max_error_index);
    return true;
}

bool check_acl(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    const char* recent_error = aclGetRecentErrMsg();
    std::fprintf(stderr, "[Failed] %s returned %d", operation, static_cast<int>(status));
    if (recent_error != nullptr) {
        std::fprintf(stderr, ": %s", recent_error);
    }
    std::fprintf(stderr, "\n");
    return false;
}
} // 匿名命名空间

__simt_callee__ inline float fused_bias_silu_value(
    float input, float bias, float residual)
{
    const float value = input + bias;
    return residual + value / (1.0f + expf(-value));
}

#if SCENARIO_NUM <= 2
__aicore__ inline void copy_row_gm_to_ub(
    __ubuf__ float* input_ub, __ubuf__ float* residual_ub, __gm__ float* input, __gm__ float* residual,
    uint32_t row)
{
    const uint32_t row_offset = row * HIDDEN_SIZE;
    asc_copy_gm2ub_align(input_ub, input + row_offset, TILE_BYTES);
    asc_copy_gm2ub_align(residual_ub, residual + row_offset, TILE_BYTES);
}

__aicore__ inline void copy_row_ub_to_gm(
    __gm__ float* output, __ubuf__ float* output_ub, uint32_t row)
{
    asc_copy_ub2gm_align(output + row * HIDDEN_SIZE, output_ub, TILE_BYTES);
}
#endif

#if SCENARIO_NUM == 0
__simt_vf__ __launch_bounds__(THREADS_PER_BLOCK) inline void simt_fused_bias_silu_ub_loop(
    __ubuf__ float* output, __ubuf__ float* input, __ubuf__ float* bias, __ubuf__ float* residual,
    uint32_t hidden)
{
    for (uint32_t col = threadIdx.x; col < hidden; col += blockDim.x) {
        output[col] = fused_bias_silu_value(input[col], bias[col], residual[col]);
    }
}
#endif

#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2
__simt_vf__ __launch_bounds__(THREADS_PER_BLOCK) inline void simt_fused_bias_silu_ub_unroll2(
    __ubuf__ float* output, __ubuf__ float* input, __ubuf__ float* bias, __ubuf__ float* residual)
{
    // HIDDEN_SIZE 恰好等于 2 * THREADS_PER_BLOCK：无循环分支、无步长更新、无运行时边界判断。
    const uint32_t col0 = threadIdx.x;
    const uint32_t col1 = col0 + THREADS_PER_BLOCK;
    output[col0] = fused_bias_silu_value(input[col0], bias[col0], residual[col0]);
    output[col1] = fused_bias_silu_value(input[col1], bias[col1], residual[col1]);
}
#endif

#if SCENARIO_NUM == 3
__simt_vf__ __launch_bounds__(THREADS_PER_BLOCK) inline void simt_fused_bias_silu_seg(
    __ubuf__ float* output, __ubuf__ float* input, __ubuf__ float* bias, __ubuf__ float* residual)
{
    // 每个线程处理段内一个元素；SEG_FLOATS == THREADS_PER_BLOCK，无循环控制流。
    output[threadIdx.x] = fused_bias_silu_value(input[threadIdx.x], bias[threadIdx.x], residual[threadIdx.x]);
}

__aicore__ inline void copy_seg_gm_to_ub(
    __ubuf__ float* input_ub, __ubuf__ float* residual_ub, __ubuf__ float* bias_ub,
    __gm__ float* input, __gm__ float* residual, __gm__ float* bias, uint32_t seg)
{
    const uint32_t row = seg / SEGS_PER_ROW;
    const uint32_t col = (seg % SEGS_PER_ROW) * SEG_FLOATS;
    const uint32_t offset = row * HIDDEN_SIZE + col;
    asc_copy_gm2ub_align(input_ub, input + offset, SEG_BYTES);
    asc_copy_gm2ub_align(residual_ub, residual + offset, SEG_BYTES);
    // 每个段都重新加载 bias，使 GM 访问量与 Case 0 基线保持一致。
    asc_copy_gm2ub_align(bias_ub, bias + col, SEG_BYTES);
}

__aicore__ inline void copy_seg_ub_to_gm(
    __gm__ float* output, __ubuf__ float* output_ub, uint32_t seg)
{
    const uint32_t row = seg / SEGS_PER_ROW;
    const uint32_t col = (seg % SEGS_PER_ROW) * SEG_FLOATS;
    asc_copy_ub2gm_align(output + row * HIDDEN_SIZE + col, output_ub, SEG_BYTES);
}
#endif

#if SCENARIO_NUM == 0
__global__ __vector__ void fused_bias_silu_ub_kernel(
    __gm__ float* output, __gm__ float* input, __gm__ float* bias, __gm__ float* residual, uint32_t rows)
{
    __ubuf__ float input_ub[HIDDEN_SIZE];
    __ubuf__ float bias_ub[HIDDEN_SIZE];
    __ubuf__ float residual_ub[HIDDEN_SIZE];
    __ubuf__ float output_ub[HIDDEN_SIZE];

    for (uint32_t row = block_idx; row < rows; row += block_num) {
        asc_lock(PIPE_MTE2, SINGLE_BUFFER_MUTEX);
        copy_row_gm_to_ub(input_ub, residual_ub, input, residual, row);
        // Case 0 中每一行都会重新加载广播用的 bias。
        asc_copy_gm2ub_align(bias_ub, bias, TILE_BYTES);
        asc_unlock(PIPE_MTE2, SINGLE_BUFFER_MUTEX);

        asc_lock(PIPE_V, SINGLE_BUFFER_MUTEX);
        asc_vf_call<simt_fused_bias_silu_ub_loop>(
            dim3(THREADS_PER_BLOCK), output_ub, input_ub, bias_ub, residual_ub, HIDDEN_SIZE);
        asc_unlock(PIPE_V, SINGLE_BUFFER_MUTEX);

        asc_lock(PIPE_MTE3, SINGLE_BUFFER_MUTEX);
        copy_row_ub_to_gm(output, output_ub, row);
        asc_unlock(PIPE_MTE3, SINGLE_BUFFER_MUTEX);
    }
}
#endif

#if SCENARIO_NUM == 1
__global__ __vector__ void fused_bias_silu_unroll_kernel(
    __gm__ float* output, __gm__ float* input, __gm__ float* bias, __gm__ float* residual, uint32_t rows)
{
    __ubuf__ float input_ub[HIDDEN_SIZE];
    __ubuf__ float bias_ub[HIDDEN_SIZE];
    __ubuf__ float residual_ub[HIDDEN_SIZE];
    __ubuf__ float output_ub[HIDDEN_SIZE];

    // 与 Case 0 完全相同，仅 SIMT VF 使用固定的双列映射（无运行时循环）。
    for (uint32_t row = block_idx; row < rows; row += block_num) {
        asc_lock(PIPE_MTE2, SINGLE_BUFFER_MUTEX);
        copy_row_gm_to_ub(input_ub, residual_ub, input, residual, row);
        asc_copy_gm2ub_align(bias_ub, bias, TILE_BYTES);
        asc_unlock(PIPE_MTE2, SINGLE_BUFFER_MUTEX);

        asc_lock(PIPE_V, SINGLE_BUFFER_MUTEX);
        asc_vf_call<simt_fused_bias_silu_ub_unroll2>(
            dim3(THREADS_PER_BLOCK), output_ub, input_ub, bias_ub, residual_ub);
        asc_unlock(PIPE_V, SINGLE_BUFFER_MUTEX);

        asc_lock(PIPE_MTE3, SINGLE_BUFFER_MUTEX);
        copy_row_ub_to_gm(output, output_ub, row);
        asc_unlock(PIPE_MTE3, SINGLE_BUFFER_MUTEX);
    }
}
#endif

#if SCENARIO_NUM == 2
__global__ __vector__ void fused_bias_silu_row_db_kernel(
    __gm__ float* output, __gm__ float* input, __gm__ float* bias, __gm__ float* residual, uint32_t rows)
{
    __ubuf__ float input_ub[2][HIDDEN_SIZE];
    __ubuf__ float bias_ub[2][HIDDEN_SIZE];
    __ubuf__ float residual_ub[2][HIDDEN_SIZE];
    __ubuf__ float output_ub[2][HIDDEN_SIZE];

    // 合并后的流水化步骤，来自 PipeTimeline 的两个发现：
    // 1) 所有 pipe 共用一个 mutex 会使 MTE2/SIMT/MTE3 串行化（伪依赖）；
    // 2) 单缓冲区会使 MTE2(n+1) 等待 SIMT(n)、SIMT(n+1) 等待 MTE3(n)。
    // 采用两组缓冲区并为输入/输出使用独立的 mutex，可以让
    // MTE2(n+1)、SIMT(n)、MTE3(n-1) 在不同缓冲区上并行重叠执行。
    uint32_t loop_count = 0;
    for (uint32_t row = block_idx; row < rows; row += block_num) {
        const uint32_t buffer = loop_count & 1U;
        const uint8_t input_mutex = DB_INPUT_MUTEX_BASE + static_cast<uint8_t>(buffer);
        const uint8_t output_mutex = DB_OUTPUT_MUTEX_BASE + static_cast<uint8_t>(buffer);

        asc_lock(PIPE_MTE2, input_mutex);
        copy_row_gm_to_ub(input_ub[buffer], residual_ub[buffer], input, residual, row);
        asc_copy_gm2ub_align(bias_ub[buffer], bias, TILE_BYTES);
        asc_unlock(PIPE_MTE2, input_mutex);

        asc_lock(PIPE_V, input_mutex);
        asc_lock(PIPE_V, output_mutex);
        asc_vf_call<simt_fused_bias_silu_ub_unroll2>(
            dim3(THREADS_PER_BLOCK), output_ub[buffer], input_ub[buffer], bias_ub[buffer], residual_ub[buffer]);
        asc_unlock(PIPE_V, input_mutex);
        asc_unlock(PIPE_V, output_mutex);

        asc_lock(PIPE_MTE3, output_mutex);
        copy_row_ub_to_gm(output, output_ub[buffer], row);
        asc_unlock(PIPE_MTE3, output_mutex);
        ++loop_count;
    }
}
#endif

#if SCENARIO_NUM == 3
__global__ __vector__ void fused_bias_silu_double_buffer_kernel(
    __gm__ float* output, __gm__ float* input, __gm__ float* bias, __gm__ float* residual, uint32_t rows)
{
    __ubuf__ float input_ub[2][SEG_FLOATS];
    __ubuf__ float bias_ub[2][SEG_FLOATS];
    __ubuf__ float residual_ub[2][SEG_FLOATS];
    __ubuf__ float output_ub[2][SEG_FLOATS];

    // 合并后的流水化步骤：拆分输入/输出 mutex（消除伪依赖）并配合完整双缓冲，
    // 使 MTE2(n+1)、SIMT(n)、MTE3(n-1) 在不同缓冲组上并行重叠执行。
    const uint32_t seg_total = rows * SEGS_PER_ROW;
    uint32_t loop_count = 0;
    for (uint32_t seg = block_idx; seg < seg_total; seg += block_num) {
        const uint32_t buffer = loop_count & 1U;
        const uint8_t input_mutex = DB_INPUT_MUTEX_BASE + static_cast<uint8_t>(buffer);
        const uint8_t output_mutex = DB_OUTPUT_MUTEX_BASE + static_cast<uint8_t>(buffer);

        asc_lock(PIPE_MTE2, input_mutex);
        copy_seg_gm_to_ub(input_ub[buffer], residual_ub[buffer], bias_ub[buffer], input, residual, bias, seg);
        asc_unlock(PIPE_MTE2, input_mutex);

        asc_lock(PIPE_V, input_mutex);
        asc_lock(PIPE_V, output_mutex);
        asc_vf_call<simt_fused_bias_silu_seg>(
            dim3(SEG_FLOATS), output_ub[buffer], input_ub[buffer], bias_ub[buffer], residual_ub[buffer]);
        asc_unlock(PIPE_V, input_mutex);
        asc_unlock(PIPE_V, output_mutex);

        asc_lock(PIPE_MTE3, output_mutex);
        copy_seg_ub_to_gm(output, output_ub[buffer], seg);
        asc_unlock(PIPE_MTE3, output_mutex);
        ++loop_count;
    }
}
#endif

void launch_case_kernel(
    float* output, float* input, float* bias, float* residual, const LaunchConfig& config)
{
#if SCENARIO_NUM == 0
    fused_bias_silu_ub_kernel<<<config.core_num, 0, config.stream>>>(
        output, input, bias, residual, config.rows);
#elif SCENARIO_NUM == 1
    fused_bias_silu_unroll_kernel<<<config.core_num, 0, config.stream>>>(
        output, input, bias, residual, config.rows);
#elif SCENARIO_NUM == 2
    fused_bias_silu_row_db_kernel<<<config.core_num, 0, config.stream>>>(
        output, input, bias, residual, config.rows);
#elif SCENARIO_NUM == 3
    fused_bias_silu_double_buffer_kernel<<<config.core_num, 0, config.stream>>>(
        output, input, bias, residual, config.rows);
#endif
}

bool run_case(
    const std::vector<float>& input_host, const std::vector<float>& bias_host,
    const std::vector<float>& residual_host, uint32_t rows, std::vector<float>& output_host)
{
    const size_t tensor_bytes = input_host.size() * sizeof(float);
    const size_t bias_bytes = bias_host.size() * sizeof(float);
    aclrtStream stream = nullptr;
    float* input_device = nullptr;
    float* bias_device = nullptr;
    float* residual_device = nullptr;
    float* output_device = nullptr;
    bool device_set = false;
    bool acl_initialized = false;

    auto cleanup = [&]() {
        if (input_device != nullptr) aclrtFree(input_device);
        if (bias_device != nullptr) aclrtFree(bias_device);
        if (residual_device != nullptr) aclrtFree(residual_device);
        if (output_device != nullptr) aclrtFree(output_device);
        if (stream != nullptr) aclrtDestroyStream(stream);
        if (device_set) aclrtResetDevice(DEVICE_ID);
        if (acl_initialized) aclFinalize();
    };

    if (!check_acl(aclInit(nullptr), "aclInit")) return false;
    acl_initialized = true;
    if (!check_acl(aclrtSetDevice(DEVICE_ID), "aclrtSetDevice")) {
        cleanup();
        return false;
    }
    device_set = true;

    int64_t vector_core_num = 0;
    if (!check_acl(
            aclrtGetDeviceInfo(DEVICE_ID, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vector_core_num),
            "aclrtGetDeviceInfo(ACL_DEV_ATTR_VECTOR_CORE_NUM)") ||
        vector_core_num <= 0) {
        cleanup();
        return false;
    }
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream") ||
        !check_acl(aclrtMalloc(reinterpret_cast<void**>(&input_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(input)") ||
        !check_acl(aclrtMalloc(reinterpret_cast<void**>(&bias_device), bias_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(bias)") ||
        !check_acl(aclrtMalloc(reinterpret_cast<void**>(&residual_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(residual)") ||
        !check_acl(aclrtMalloc(reinterpret_cast<void**>(&output_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(output)") ||
        !check_acl(aclrtMemcpy(input_device, tensor_bytes, input_host.data(), tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(input)") ||
        !check_acl(aclrtMemcpy(bias_device, bias_bytes, bias_host.data(), bias_bytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(bias)") ||
        !check_acl(aclrtMemcpy(residual_device, tensor_bytes, residual_host.data(), tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(residual)")) {
        cleanup();
        return false;
    }

    // 小规模 profiling 场景下不启动空 block；同时在 rows 较小时（例如 rows=32），
    // 保证 A5 动态插桩的 sub-block 数量低于 108 的告警阈值。
    const uint32_t active_blocks =
        rows < static_cast<uint32_t>(vector_core_num) ? rows : static_cast<uint32_t>(vector_core_num);
    const LaunchConfig config = {rows, active_blocks, stream};
    launch_case_kernel(output_device, input_device, bias_device, residual_device, config);
    const bool success =
        check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") &&
        check_acl(
            aclrtMemcpy(output_host.data(), tensor_bytes, output_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(output)");
    cleanup();
    return success;
}

int main(int argc, char** argv)
{
    uint32_t rows = 256;
    if (argc > 2) {
        std::fprintf(stderr, "Usage: %s [rows]\n", argv[0]);
        return EXIT_FAILURE;
    }
    if (argc == 2) {
        char* end = nullptr;
        const unsigned long value = std::strtoul(argv[1], &end, 10);
        if (end == argv[1] || *end != '\0' || value > UINT32_MAX) {
            std::fprintf(stderr, "rows must be an integer in [1, %u].\n", UINT32_MAX);
            return EXIT_FAILURE;
        }
        rows = static_cast<uint32_t>(value);
    }

    const size_t element_count = static_cast<size_t>(rows) * HIDDEN_SIZE;
    if (element_count > UINT32_MAX) {
        std::fprintf(stderr, "rows * hidden must not exceed %u elements.\n", UINT32_MAX);
        return EXIT_FAILURE;
    }

    std::printf("Running Case %d: %s\n", SCENARIO_NUM, get_case_name());
    std::printf("Shape: [%u, %u], threads/block: %u, logical device: %u\n",
        rows, HIDDEN_SIZE, THREADS_PER_BLOCK, DEVICE_ID);

    std::vector<float> input(element_count);
    std::vector<float> residual(element_count);
    std::vector<float> bias(HIDDEN_SIZE);
    for (size_t i = 0; i < element_count; ++i) {
        input[i] = static_cast<float>(static_cast<int32_t>(i % 97) - 48) / 16.0f;
        residual[i] = static_cast<float>(static_cast<int32_t>(i % 31) - 15) / 32.0f;
    }
    for (uint32_t col = 0; col < HIDDEN_SIZE; ++col) {
        bias[col] = static_cast<float>(static_cast<int32_t>(col % 17) - 8) / 32.0f;
    }

    const std::vector<float> golden = compute_golden(input, bias, residual, rows);
    std::vector<float> output(element_count, 0.0f);
    if (!run_case(input, bias, residual, rows, output)) {
        return EXIT_FAILURE;
    }
    return verify_result(output, golden) ? EXIT_SUCCESS : EXIT_FAILURE;
}
