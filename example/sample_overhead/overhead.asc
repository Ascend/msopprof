/* !
 * \file overhead.asc
 * \brief Scalar 头开销优化样例，演示 TPipe 作为类成员抑制编译器 Scalar 折叠优化的问题及优化方法
 *
 * 算子逻辑: y[i] = x[i] + bias[i], i ∈ [0, TOTAL_LENGTH)
 *
 * 优化前（反例）: TPipe 对象由 KernelExample 类内部创建并初始化，抑制编译器常量折叠
 * 优化后（正例）: TPipe 对象在核函数入口创建，类内仅保存 TPipe 指针，触发 Scalar 折叠优化
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdlib>

constexpr uint32_t TOTAL_LENGTH = 128 * 40;
constexpr uint32_t TILE_LENGTH = 512;
constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t BLOCK_DIM = 1;

class VectorAddKernel {
public:
    __aicore__ inline VectorAddKernel() {}

    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR biasGm, GM_ADDR yGm)
    {
        uint32_t elementsPerCore = TOTAL_LENGTH / BLOCK_DIM;
        uint32_t coreOffset = AscendC::GetBlockIdx() * elementsPerCore;

        xGlobal.SetGlobalBuffer((__gm__ half *)xGm + coreOffset, elementsPerCore);
        biasGlobal.SetGlobalBuffer((__gm__ half *)biasGm + coreOffset, elementsPerCore);
        yGlobal.SetGlobalBuffer((__gm__ half *)yGm + coreOffset, elementsPerCore);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueBias, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(half));

        tilesPerCore = elementsPerCore / TILE_LENGTH;
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tilesPerCore; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        AscendC::LocalTensor<half> biasLocal = inQueueBias.AllocTensor<half>();
        AscendC::DataCopy(xLocal, xGlobal[progress * TILE_LENGTH], TILE_LENGTH);
        AscendC::DataCopy(biasLocal, biasGlobal[progress * TILE_LENGTH], TILE_LENGTH);
        inQueueX.EnQue(xLocal);
        inQueueBias.EnQue(biasLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        AscendC::LocalTensor<half> biasLocal = inQueueBias.DeQue<half>();
        AscendC::LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        AscendC::Add(yLocal, xLocal, biasLocal, TILE_LENGTH);
        outQueueY.EnQue<half>(yLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueBias.FreeTensor(biasLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        AscendC::DataCopy(yGlobal[progress * TILE_LENGTH], yLocal, TILE_LENGTH);
        outQueueY.FreeTensor(yLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueBias;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    AscendC::GlobalTensor<half> xGlobal;
    AscendC::GlobalTensor<half> biasGlobal;
    AscendC::GlobalTensor<half> yGlobal;
    uint32_t tilesPerCore = 0;
};

__global__ __vector__ void vector_add_custom(GM_ADDR x, GM_ADDR bias, GM_ADDR y)
{
    AscendC::InitSocState();
    VectorAddKernel op;
    op.Init(x, bias, y);
    op.Process();
}

int32_t main(int32_t argc, char *argv[])
{
    size_t totalBytes = TOTAL_LENGTH * sizeof(half);

    aclInit(nullptr);

    int32_t deviceId = (argc > 1) ? atoi(argv[1]) : 0;
    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *devX = nullptr;
    uint8_t *devBias = nullptr;
    uint8_t *devY = nullptr;
    aclrtMalloc((void **)&devX, totalBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&devBias, totalBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&devY, totalBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(devX, totalBytes, 0, totalBytes);
    aclrtMemset(devBias, totalBytes, 0, totalBytes);

    vector_add_custom<<<BLOCK_DIM, nullptr, stream>>>(devX, devBias, devY);
    aclrtSynchronizeStream(stream);

    aclrtFree(devX);
    aclrtFree(devBias);
    aclrtFree(devY);
    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
