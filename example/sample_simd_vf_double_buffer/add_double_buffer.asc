/* !
 * \file add_double_buffer.asc
 * \brief 融合向量计算流水诊断样例
 */

#include <cstdio>
#include <cstdint>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

// 案例规格为[16, 8192]，单核处理六个满块和一个尾块。
constexpr uint32_t TOTAL_M = 16;
constexpr uint32_t TOTAL_N = 8192;
constexpr uint32_t SPLIT_M = 1;
constexpr uint32_t SPLIT_N = 1;
constexpr uint32_t NUM_CORES = SPLIT_M * SPLIT_N;
// 每组Buffer分别存放输入x、输入y和输出z，因此一组包含3个Buffer。
constexpr uint32_t BUFFER_NUM_PER_GROUP = 3;
// 使用Ping和Pong两组Buffer。
constexpr uint32_t DOUBLE_BUFFER_GROUP_NUM = 2;
constexpr uint32_t DOUBLE_BUFFER_NUM = BUFFER_NUM_PER_GROUP * DOUBLE_BUFFER_GROUP_NUM;
// dav-3510共有256 KiB UB；调用SIMD VF时默认预留6 KiB VF栈和2 KiB Ascend C API空间，可用248 KiB。
constexpr uint32_t AVAILABLE_UB_CAPACITY_BYTES = 248 * 1024;
// 每个Buffer的起始地址需要按32字节对齐。
constexpr uint32_t UB_ALIGNMENT_BYTES = 32;
// 将可用UB平均划分为6个Buffer并向下按32字节对齐，每个Buffer最多容纳21152个half元素。
constexpr uint32_t MAX_DATA_COPY_LENGTH =
    AVAILABLE_UB_CAPACITY_BYTES / DOUBLE_BUFFER_NUM / UB_ALIGNMENT_BYTES * UB_ALIGNMENT_BYTES / sizeof(half);
static_assert(
    MAX_DATA_COPY_LENGTH * DOUBLE_BUFFER_NUM * sizeof(half) <= AVAILABLE_UB_CAPACITY_BYTES,
    "Double buffer exceeds available UB capacity.");
// 每轮搬运字节数按512字节对齐，以满足连续Burst的搬运要求。
constexpr uint32_t DATA_COPY_ALIGNMENT_BYTES = 512;
// 在单个Buffer容量内向下按512字节对齐，每轮实际搬运20992个half元素。
constexpr uint32_t DATA_COPY_LENGTH =
    MAX_DATA_COPY_LENGTH * sizeof(half) / DATA_COPY_ALIGNMENT_BYTES * DATA_COPY_ALIGNMENT_BYTES / sizeof(half);
// 单次VF迭代处理256字节，即128个half元素。
constexpr uint32_t VF_LENGTH = 256;
// 每个数据块的GM与UB搬运均通过一次连续Burst完成。
constexpr uint16_t BURST_NUM = 1;
// 输入和输出为流式数据，搬运时不在L2 Cache中分配Cache Line。
constexpr asc_load_l2_cache_mode LOAD_L2_CACHE_MODE = asc_load_l2_cache_mode::NOTALLOC_KEEP;
constexpr asc_store_l2_cache_mode STORE_L2_CACHE_MODE = asc_store_l2_cache_mode::NOTALLOC_CLEAN;

#ifndef FUSED_ITERATIONS
// 融合计算递推次数，14次递推对应1次初始Add和14组Mul+Add，共29条Vector算术指令。
#define FUSED_ITERATIONS 14
#endif

#if FUSED_ITERATIONS < 1
#error "FUSED_ITERATIONS must be a positive integer"
#endif

__simd_vf__ inline void fused_compute_vf(
    __ubuf__ half* z_local, __ubuf__ half* x_local, __ubuf__ half* y_local, uint32_t element_count)
{
    constexpr uint32_t elements_per_vf = VF_LENGTH / sizeof(half);
    const uint16_t repeat_times = static_cast<uint16_t>((element_count + elements_per_vf - 1) / elements_per_vf);
    vector_half x_reg;
    vector_half y_reg;
    vector_half z_reg;
    vector_half temp_reg;
    vector_bool mask;
    // 每次迭代处理一个向量宽度，最后一个不足向量宽度的数据块通过Mask处理。
    for (uint16_t i = 0; i < repeat_times; ++i) {
        mask = asc_update_mask_b16(element_count);
        asc_loadalign(x_reg, x_local + i * elements_per_vf);
        asc_loadalign(y_reg, y_local + i * elements_per_vf);
        // t0 = x + y。
        asc_add(z_reg, x_reg, y_reg, mask);
        // ti+1 = ti * x + y；中间结果保留在寄存器中，不增加GM和UB搬运量。
        for (uint32_t fused_idx = 0; fused_idx < FUSED_ITERATIONS; ++fused_idx) {
            asc_mul(temp_reg, z_reg, x_reg, mask);
            asc_add(z_reg, temp_reg, y_reg, mask);
        }
        asc_storealign(z_local + i * elements_per_vf, z_reg, mask);
    }
}

__vector__ __global__ void add_double_buffer(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    asc_init();
    // 为每个核分配连续的矩阵行。
    int64_t core_idx = block_idx;
    constexpr int64_t base_core_m = TOTAL_M / SPLIT_M;
    constexpr int64_t remainder_m = TOTAL_M % SPLIT_M;
    int64_t single_core_m;
    int64_t start_m;
    if (core_idx < remainder_m) {
        single_core_m = base_core_m + 1;
        start_m = core_idx * single_core_m;
    } else {
        single_core_m = base_core_m;
        start_m = remainder_m * (base_core_m + 1) + (core_idx - remainder_m) * base_core_m;
    }
    int64_t total_elements_per_core = single_core_m * TOTAL_N;

    // 将GM指针偏移到当前核负责的首行。
    __gm__ half* x_gm = reinterpret_cast<__gm__ half*>(x) + start_m * TOTAL_N;
    __gm__ half* y_gm = reinterpret_cast<__gm__ half*>(y) + start_m * TOTAL_N;
    __gm__ half* z_gm = reinterpret_cast<__gm__ half*>(z) + start_m * TOTAL_N;

    // 在UB中静态申请两组独立的x/y/z Buffer，用于Ping/Pong交替复用。
    __ubuf__ half ub_buffer[MAX_DATA_COPY_LENGTH * DOUBLE_BUFFER_NUM];
    __ubuf__ half* x_ping = ub_buffer;
    __ubuf__ half* y_ping = x_ping + MAX_DATA_COPY_LENGTH;
    __ubuf__ half* z_ping = y_ping + MAX_DATA_COPY_LENGTH;
    __ubuf__ half* x_pong = z_ping + MAX_DATA_COPY_LENGTH;
    __ubuf__ half* y_pong = x_pong + MAX_DATA_COPY_LENGTH;
    __ubuf__ half* z_pong = y_pong + MAX_DATA_COPY_LENGTH;

    // 向上取整计算数据块数量，由最后一次迭代处理尾块。
    uint32_t total_blocks = static_cast<uint32_t>((total_elements_per_core + DATA_COPY_LENGTH - 1) / DATA_COPY_LENGTH);

    for (uint32_t loop_idx = 0; loop_idx < total_blocks; ++loop_idx) {
        uint32_t start_element = loop_idx * DATA_COPY_LENGTH;
        int64_t remain_elements = total_elements_per_core - start_element;
        uint32_t current_length =
            remain_elements > DATA_COPY_LENGTH ? DATA_COPY_LENGTH : static_cast<uint32_t>(remain_elements);

        // ID 0/1分别保护Ping/Pong的x/y，输出Mutex ID位于输入Mutex ID之后。
        uint8_t input_mutex_id = static_cast<uint8_t>(loop_idx & 1);
        uint8_t output_mutex_id = static_cast<uint8_t>(input_mutex_id + DOUBLE_BUFFER_GROUP_NUM);
        // 偶数轮使用Ping Buffer，奇数轮使用Pong Buffer。
        __ubuf__ half* x_local = (loop_idx & 1) == 0 ? x_ping : x_pong;
        __ubuf__ half* y_local = (loop_idx & 1) == 0 ? y_ping : y_pong;
        __ubuf__ half* z_local = (loop_idx & 1) == 0 ? z_ping : z_pong;
        // 使用一次连续Burst搬运，不设置Padding和块间Stride，非对齐尾块由硬件自动填充。
        uint32_t burst_length = current_length * sizeof(half);
        uint64_t gm_stride = 0;
        uint32_t ub_stride = 0;

        // 搬入x/y，输入Mutex保证上一轮Vector读取完成后才能复用对应Buffer。
        asc_lock(PIPE_MTE2, input_mutex_id);
        asc_copy_gm2ub_align(
            x_local, x_gm + start_element, BURST_NUM, burst_length, 0, 0, false, LOAD_L2_CACHE_MODE, gm_stride,
            ub_stride);
        asc_copy_gm2ub_align(
            y_local, y_gm + start_element, BURST_NUM, burst_length, 0, 0, false, LOAD_L2_CACHE_MODE, gm_stride,
            ub_stride);
        asc_unlock(PIPE_MTE2, input_mutex_id);

        // 等待x/y数据就绪且z Buffer可写，再计算当前数据块。
        asc_lock(PIPE_V, input_mutex_id);
        asc_lock(PIPE_V, output_mutex_id);
        asc_vf_call<fused_compute_vf>(z_local, x_local, y_local, current_length);
        asc_unlock(PIPE_V, input_mutex_id);
        asc_unlock(PIPE_V, output_mutex_id);

        // 输出Mutex保护z Buffer的搬出与复用。
        asc_lock(PIPE_MTE3, output_mutex_id);
        asc_copy_ub2gm_align(
            z_gm + start_element, z_local, BURST_NUM, burst_length, STORE_L2_CACHE_MODE, gm_stride, ub_stride);
        asc_unlock(PIPE_MTE3, output_mutex_id);
        asc_sync_pipe(PIPE_ALL);
    }
    // Kernel退出前等待所有未完成的流水操作结束。
    asc_sync_pipe(PIPE_ALL);
}


struct ArgInfo {
    std::string file_name;
    size_t length;
};

struct AclResources {
    explicit AclResources(size_t input_count, size_t output_count)
        : input_host(input_count), input_device(input_count), output_host(output_count), output_device(output_count)
    {}

    aclrtStream stream = nullptr;
    std::vector<uint8_t*> input_host;
    std::vector<uint8_t*> input_device;
    std::vector<uint8_t*> output_host;
    std::vector<uint8_t*> output_device;
    bool acl_initialized = false;
    bool device_set = false;
    bool stream_created = false;
};

bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

bool prepare_inputs(AclResources& resources, const std::vector<ArgInfo>& inputs_info)
{
    // 申请Host和Device输入内存，读取输入文件并将数据拷贝到Device。
    for (size_t i = 0; i < inputs_info.size(); ++i) {
        if (!check_acl_status(
                aclrtMallocHost(reinterpret_cast<void**>(&resources.input_host[i]), inputs_info[i].length),
                "aclrtMallocHost(input_host)") ||
            !check_acl_status(
                aclrtMalloc(
                    reinterpret_cast<void**>(&resources.input_device[i]), inputs_info[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(input_device)") ||
            !ReadFile(inputs_info[i].file_name, resources.input_host[i], inputs_info[i].length) ||
            !check_acl_status(
                aclrtMemcpy(
                    resources.input_device[i], inputs_info[i].length, resources.input_host[i], inputs_info[i].length,
                    ACL_MEMCPY_HOST_TO_DEVICE),
                "aclrtMemcpy(input_device)")) {
            return false;
        }
    }
    return true;
}

bool prepare_outputs(AclResources& resources, const std::vector<ArgInfo>& outputs_info)
{
    // 为Kernel输出申请Host和Device内存。
    for (size_t i = 0; i < outputs_info.size(); ++i) {
        if (!check_acl_status(
                aclrtMallocHost(reinterpret_cast<void**>(&resources.output_host[i]), outputs_info[i].length),
                "aclrtMallocHost(output_host)") ||
            !check_acl_status(
                aclrtMalloc(
                    reinterpret_cast<void**>(&resources.output_device[i]), outputs_info[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(output_device)")) {
            return false;
        }
    }
    return true;
}

bool write_outputs(AclResources& resources, const std::vector<ArgInfo>& outputs_info)
{
    // 将结果拷贝回Host并写入输出文件。
    for (size_t i = 0; i < outputs_info.size(); ++i) {
        if (!check_acl_status(
                aclrtMemcpy(
                    resources.output_host[i], outputs_info[i].length, resources.output_device[i],
                    outputs_info[i].length, ACL_MEMCPY_DEVICE_TO_HOST),
                "aclrtMemcpy(output_host)") ||
            !WriteFile(outputs_info[i].file_name, resources.output_host[i], outputs_info[i].length)) {
            return false;
        }
    }

    return true;
}

bool run_sample(
    AclResources& resources, const std::vector<ArgInfo>& inputs_info, const std::vector<ArgInfo>& outputs_info,
    int32_t device_id)
{
    // 初始化ACL、设置Device并创建执行Stream。
    if (!check_acl_status(aclInit(nullptr), "aclInit")) {
        return false;
    }
    resources.acl_initialized = true;
    if (!check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        return false;
    }
    resources.device_set = true;
    if (!check_acl_status(aclrtCreateStream(&resources.stream), "aclrtCreateStream")) {
        return false;
    }
    resources.stream_created = true;

    if (!prepare_inputs(resources, inputs_info) || !prepare_outputs(resources, outputs_info)) {
        return false;
    }

    // 启动Kernel并等待执行完成。
    add_double_buffer<<<NUM_CORES, 0, resources.stream>>>(
        resources.input_device[0], resources.input_device[1], resources.output_device[0]);
    if (!check_acl_status(aclrtSynchronizeStream(resources.stream), "aclrtSynchronizeStream")) {
        return false;
    }

    return write_outputs(resources, outputs_info);
}

bool release_resources(AclResources& resources, int32_t device_id)
{
    // 释放所有已成功创建的资源，并保留清理过程中出现的错误状态。
    bool success = true;
    for (size_t i = 0; i < resources.output_device.size(); ++i) {
        if (resources.output_device[i] != nullptr &&
            !check_acl_status(aclrtFree(resources.output_device[i]), "aclrtFree(output_device)")) {
            success = false;
        }
        if (resources.output_host[i] != nullptr &&
            !check_acl_status(aclrtFreeHost(resources.output_host[i]), "aclrtFreeHost(output_host)")) {
            success = false;
        }
    }
    for (size_t i = 0; i < resources.input_device.size(); ++i) {
        if (resources.input_device[i] != nullptr &&
            !check_acl_status(aclrtFree(resources.input_device[i]), "aclrtFree(input_device)")) {
            success = false;
        }
        if (resources.input_host[i] != nullptr &&
            !check_acl_status(aclrtFreeHost(resources.input_host[i]), "aclrtFreeHost(input_host)")) {
            success = false;
        }
    }
    if (resources.stream_created && !check_acl_status(aclrtDestroyStream(resources.stream), "aclrtDestroyStream")) {
        success = false;
    }
    if (resources.device_set && !check_acl_status(aclrtResetDevice(device_id), "aclrtResetDevice")) {
        success = false;
    }
    if (resources.acl_initialized && !check_acl_status(aclFinalize(), "aclFinalize")) {
        success = false;
    }

    return success;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    printf("Usage: %s (C API fused vector pipeline sample)\n", argv[0]);
    // 每个输入和输出包含16 x 8192个half元素，样例在仿真Device 0上运行。
    constexpr uint32_t data_length = TOTAL_M * TOTAL_N;
    constexpr size_t data_byte_size = data_length * sizeof(uint16_t);
    constexpr int32_t device_id = 0;

    const std::vector<ArgInfo> inputs_info = {
        {"./input/input_x.bin", data_byte_size},
        {"./input/input_y.bin", data_byte_size},
    };
    const std::vector<ArgInfo> outputs_info = {{"./output/output.bin", data_byte_size}};
    AclResources resources(inputs_info.size(), outputs_info.size());

    int32_t result = run_sample(resources, inputs_info, outputs_info, device_id) ? 0 : 1;
    if (!release_resources(resources, device_id)) {
        result = 1;
    }
    if (result == 0) {
        printf("C API Add performance sample completed.\n");
    }
    return result;
}
